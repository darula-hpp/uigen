{
  "name": "uigen-devboard-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "UIGen control panel for the DevBoard simulator (deploy separately from the board app)",
  "scripts": {
    "dev": "uigen serve openapi.yaml --proxy-base http://localhost:3000 --port 4400",
    "build": "node scripts/build-vercel.mjs",
    "start": "uigen serve openapi.yaml --port ${PORT:-8080} --proxy-base ${BOARD_URL}",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uigen-dev/cli": "^0.18.0",
    "@uigen-dev/core": "^0.18.0",
    "@uigen-dev/react": "^0.18.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
